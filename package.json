{
  "name": "@gurbaninow/hukamnama-archive",
  "version": "1.0.0",
  "description": "Fetch and store the latest Mukhvaak from Sri Darbar Sahib, Sri Amritsar.",
  "type": "module",
  "scripts": {
    "fetch": "node index.ts",
    "fetch:sgpc": "node index.ts --source sgpc",
    "fetch:sikhnet": "node index.ts --source sikhnet",
    "fetch:force": "node index.ts --force",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gurbaninow/hukamnama-archive.git"
  },
  "author": "Sarabveer Singh <me@sarabveer.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gurbaninow/hukamnama-archive/issues"
  },
  "homepage": "https://github.com/gurbaninow/hukamnama-archive#readme",
  "dependencies": {
    "@gurbaninow/database": "^5.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fast-xml-parser": "^5.12.0",
    "gurmukhi-utils": "^3.2.2",
    "jsdom": "^31.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "typescript": "~7.0.2"
  }
}
